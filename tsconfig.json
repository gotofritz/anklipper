{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true
  },
  "include": [".wxt/wxt.d.ts", "**/*.ts", "**/*.svelte"],
  "exclude": ["node_modules", ".output", "coverage"]
}
